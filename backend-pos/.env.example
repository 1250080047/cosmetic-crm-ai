# Copy to .env; that file is ignored by Git.
# Enable only after choosing to share the documented store aggregates with Google Gemini.
GEMINI_ALLOW_STORE_CONTEXT=0
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=your_existing_key
# SQL Server
DB_SERVER=localhost
DB_NAME=cosmetic_crm_db
# Ngày tham chiếu của dữ liệu nền (mặc định 2021-01-12, ngày sau hóa đơn cuối của OnlineSales)
# BASE_REFERENCE_DATE=2021-01-12
DB_USER=sa
DB_PASSWORD=your_password

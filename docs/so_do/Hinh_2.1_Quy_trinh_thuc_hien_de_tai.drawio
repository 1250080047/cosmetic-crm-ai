<mxfile host="app.diagrams.net"><diagram id="quytrinh21" name="QUY TRINH THUC HIEN"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="g1" value="Quy trình khai phá dữ liệu (CRISP-DM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=6 4;strokeColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="20" width="1140" height="190" /></mxCell><mxCell id="c0" value="&lt;b style=&quot;font-size:15px&quot;&gt;1. Hiểu nghiệp vụ&lt;/b&gt;&lt;br&gt;bán lẻ mỹ phẩm,&lt;br&gt;mục tiêu phân khúc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="58" width="150" height="98" /></mxCell><mxCell id="c1" value="&lt;b style=&quot;font-size:15px&quot;&gt;2. Hiểu dữ liệu&lt;/b&gt;&lt;br&gt;OnlineSales&lt;br&gt;250.000 dòng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="58" width="150" height="98" /></mxCell><mxCell id="c2" value="&lt;b style=&quot;font-size:15px&quot;&gt;3. Chuẩn bị dữ liệu&lt;/b&gt;&lt;br&gt;làm sạch, quy đổi,&lt;br&gt;nạp SQL Server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="58" width="150" height="98" /></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:15px&quot;&gt;4. Mô hình hóa&lt;/b&gt;&lt;br&gt;LRFM + K-Means" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="610" y="58" width="150" height="98" /></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:15px&quot;&gt;5. Đánh giá&lt;/b&gt;&lt;br&gt;Elbow, Silhouette,&lt;br&gt;Davies–Bouldin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="58" width="150" height="98" /></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:15px&quot;&gt;6. Triển khai&lt;/b&gt;&lt;br&gt;dịch vụ AI, POS,&lt;br&gt;giám sát lệch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="58" width="150" height="98" /></mxCell><mxCell id="ce0" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c0" target="c1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ce1" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ce2" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ce3" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ce4" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n1" value="↺ Quay lại bước 3–4 khi đánh giá chưa đạt hoặc khi phát hiện lệch dữ liệu (huấn luyện lại có kiểm soát)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=14;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="166" width="1100" height="30" /></mxCell><mxCell id="g2" value="Quy trình phát triển phần mềm lặp tăng dần" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=6 4;strokeColor=#000000;fontFamily=Times New Roman;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="270" width="1140" height="190" /></mxCell><mxCell id="d0" value="&lt;b style=&quot;font-size:15px&quot;&gt;Phân tích yêu cầu&lt;/b&gt;&lt;br&gt;use case, đặc tả" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="308" width="176" height="98" /></mxCell><mxCell id="d1" value="&lt;b style=&quot;font-size:15px&quot;&gt;Thiết kế&lt;/b&gt;&lt;br&gt;kiến trúc, CSDL SQL Server, API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="271" y="308" width="176" height="98" /></mxCell><mxCell id="d2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Lập trình&lt;/b&gt;&lt;br&gt;Spring Boot, FastAPI,&lt;br&gt;giao diện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="502" y="308" width="176" height="98" /></mxCell><mxCell id="d3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Kiểm thử&lt;/b&gt;&lt;br&gt;đơn vị, tích hợp,&lt;br&gt;giao diện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="733" y="308" width="176" height="98" /></mxCell><mxCell id="d4" value="&lt;b style=&quot;font-size:15px&quot;&gt;Bàn giao&lt;/b&gt;&lt;br&gt;phiên bản chạy được" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=14;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="964" y="308" width="176" height="98" /></mxCell><mxCell id="de0" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d0" target="d1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="de1" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="de2" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="d3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="de3" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="d4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n2" value="↺ Mỗi vòng lặp bổ sung một nhóm chức năng (POS → phân cụm → ưu đãi → thẻ thành viên → kho, đánh giá, đối soát)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=14;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="416" width="1100" height="30" /></mxCell><mxCell id="link" value="Mô hình được đóng gói thành dịch vụ FastAPI và tích hợp vào ứng dụng Spring Boot" style="startArrow=block;startFill=1;startSize=8;endArrow=block;endFill=1;endSize=8;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Times New Roman;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="g1" target="g2"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>
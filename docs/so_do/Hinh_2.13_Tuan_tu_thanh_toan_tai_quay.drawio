ẩm và lô (UPDLOCK)" style="html=1;fontFamily=Times New Roman;fontSize=15;strokeColor=#000000;rounded=0;labelBackgroundColor=none;endArrow=open;endSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="596" y="666" /><mxPoint as="targetPoint" x="894" y="666" /></mxGeometry></mxCell><mxCell id="v29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="752" width="12" height="26" /></mxCell><mxCell id="e30" value="" style="html=1;fontFamily=Times New Roman;fontSize=15;strokeColor=#000000;rounded=0;labelBackgroundColor=none;endArrow=open;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="596" y="732" /><mxPoint as="targetPoint" x="602" y="760" /><Array as="points"><mxPoint x="632" y="732" /><mxPoint x="632" y="760" /></Array></mxGeometry></mxCell><mxCell id="v31" value="11. Tính lại tổng tiền, ưu đãi, điểm&lt;br&gt;(từ chối nếu khác số gửi lên)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="724" width="260" height="44" /></mxCell><mxCell id="e32" value="12. INSERT orders, order_items,&lt;br&gt;order_item_lots (FEFO), trừ tồn kho" style="html=1;fontFamily=Times New Roman;fontSize=15;strokeColor=#000000;rounded=0;labelBackgroundColor=none;endArrow=open;endSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="596" y="832" /><mxPoint as="targetPoint" x="894" y="832" /></mxGeometry></mxCell><mxCell id="e33" value="13. Dự đoán lại nhóm sau hóa đơn" style="html=1;fontFamily=Times New Roman;fontSize=15;strokeColor=#000000;rounded=0;labelBackgroundColor=none;endArrow=open;endSize=10;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" x="-0.45" as="geometry"><mxPoint as="sou